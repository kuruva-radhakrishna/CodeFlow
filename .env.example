# API server
PORT=3000
NODE_ENV=development

# PostgreSQL (durable source of truth)
DATABASE_URL=postgres://codeflow:codeflow@localhost:5432/codeflow

# Redis (queue, rate limits, leases)
REDIS_URL=redis://localhost:6379

# Judge0 execution engine
# Public CE instance: no key needed, low rate limit (~50 req/day) - fine for early development.
# Swap to a RapidAPI key (X-RapidAPI-Key) or a self-hosted instance later without changing app code.
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=

# Per-user rate limit (submissions per minute)
RATE_LIMIT_PER_MINUTE=5
