# API server
# Named API_PORT (not PORT) specifically so a shared local .env can't collide with the worker's
# own optional PORT (see below) when both run side by side. A PaaS like Render injects PORT
# itself for whichever service reads it - each service's env is isolated there, so no clash.
API_PORT=3000
NODE_ENV=development

# PostgreSQL (durable source of truth)
DATABASE_URL=postgres://codeflow:codeflow@localhost:5432/codeflow

# Redis (queue, rate limits, leases)
REDIS_URL=redis://localhost:6379

# Judge0 execution engine (worker only - the API never talks to Judge0 directly)
# JUDGE0_PROVIDER=mock runs entirely without Judge0: a fake execution provider behind the exact
# same adapter contract (worker/src/judge0/), zero external calls, zero credentials needed. Good
# for local dev and the queue/system load test (see load-tests/). Leave unset (or "real") to use
# an actual Judge0 instance:
#JUDGE0_PROVIDER=mock

# Only used when JUDGE0_PROVIDER is unset or "real". Public CE instance: no key needed, low rate
# limit (~50 req/day) - fine for a handful of correctness checks, not for load testing. Swap to a
# RapidAPI key (X-RapidAPI-Key) or a self-hosted instance later without changing app code.
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=

# Per-user rate limit (submissions per minute)
RATE_LIMIT_PER_MINUTE=5

# Worker only. Leave unset for normal local dev / a real background-worker deploy - the worker
# runs its queue/lease/retry loops with no HTTP server at all. Only set this if deploying the
# worker on a platform that requires a bound port to consider it "up" (e.g. Render's free-tier
# Web Service type instead of the paid Background Worker type) - see worker/src/healthServer.js.
#PORT=
